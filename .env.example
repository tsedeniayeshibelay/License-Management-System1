# DATABASE
DB_PASSWORD=your_database_password_here

# SECURITY SECRETS
JWT_SECRET=your_super_secure_jwt_secret_key_here
HMAC_SECRET=your_super_secure_hmac_secret_key_here

# EMAIL
MAIL_USERNAME=your_gmail_address_here@gmail.com
MAIL_PASSWORD=your_google_app_password_here

# WEBHOOKS
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# RSA KEYS FOR OFFLINE / QR ACTIVATION (Optional in dev; automatically generated if omitted)
RSA_PRIVATE_KEY=your_base64_encoded_pkcs8_rsa_private_key_here
RSA_PUBLIC_KEY=your_base64_encoded_x509_rsa_public_key_here
